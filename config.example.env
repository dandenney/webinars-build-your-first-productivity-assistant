# Used only by an optional SMTP adapter you provide. Local mode needs no secrets.
SIGNALBOARD_DEMO_RECIPIENT=demo@example.com
SIGNALBOARD_LAUNCH_DATE=2026-08-04

# Never commit credentials. The bundled scripts intentionally do not assume a provider.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
